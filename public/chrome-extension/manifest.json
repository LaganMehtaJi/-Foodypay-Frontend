{
  "manifest_version": 3,
  "name": "FoodyPay POS Real-Time Alerts",
  "version": "1.0.0",
  "description": "Receive real-time order alerts & push notifications from your FoodyPay Dashboard directly on your Chrome desktop.",
  "permissions": [
    "notifications",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
