{
  "manifest_version": 3,
  "name": "FoodyPay Silent POS Printer",
  "version": "1.0.0",
  "description": "Silent printing extension for FoodyPay POS. Print KOT & Bill to separate thermal printers without print dialog box.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:19999/*",
    "http://localhost:19999/*"
  ],
  "icons": {
    "64": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FoodyPay POS Printer",
    "default_icon": "icon.png"
  }
}
